# Supabase — Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=ey...  # server-side only, never expose to browser

# Device auth — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEVICE_API_KEY=replace-with-32-plus-char-random-string
